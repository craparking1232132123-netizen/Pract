#include <iostream>
using namespace std;

int main() {
    setlocale(0, "");
    int n;
    cout << "[+]  \"While\"" << endl;
    while (true) {
        cout << "[+] Введите число: ";
        cin >> n;
        if (n == 0) break;
        if (n < 0 || n > 15) { cout << "[+] Ошибка!" << endl; continue; }
        int i = 1;
        while (i <= n) { cout << "[+]  Круг: " << i << "." << endl; i++; }
    }
    return 0;
}
