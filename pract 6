#include <iostream>
#include <string>

using namespace std;


int main() {
    setlocale(0, "");
    int month;

    cout << "Программа 'Месяца года'" << endl;
    cout << "Выберите месяц (введите номер от 1 до 12): ";
    cin >> month;

    switch (month) {
    case 1:
        cout << "Месяца года" << endl;
        cout << "Январь" << endl;
        break;

    case 2:
        cout << "Выберите месяц: 2" << endl;
        cout << "Выбран месяц \"Февраль\"" << endl;
        break;

    case 3:
        cout << "Выбран месяц \"Март\"" << endl;
        break;

    case 4:
        cout << "Выбран месяц \"Апрель\"" << endl;
        break;

    case 5:
        cout << "Выбран месяц \"Май\"" << endl;
        break;

    case 6:
        cout << "Выбран месяц \"Июнь\"" << endl;
        break;

    case 7:
        cout << "Выбран месяц \"Июль\"" << endl;
        break;

    case 8:
        cout << "Выбран месяц \"Август\"" << endl;
        break;

    case 9:
        cout << "Выбран месяц \"Сентябрь\"" << endl;
        break;

    case 10:
        cout << "Выбран месяц \"Октябрь\"" << endl;
        break;

    case 11:
        cout << "Выбран месяц \"Ноябрь\"" << endl;
        break;

    case 12:
        cout << "Декабрь" << endl;
        break;

    default:
        cout << "Выберите месяц: " << month << endl;
        cout << "Не правильно введен номер месяца!" << endl;
        break;
    }

    return 0;
}
